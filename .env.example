# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=persona_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Async Database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/persona_agent

# LangGraph Checkpointer Postgres Connection String (psycopg format)
CHECKPOINTER_DB_URL=postgresql://postgres:postgres@localhost:5432/persona_agent

# Google Gemini API Key
GEMINI_API_KEY=

# Default Models
DEFAULT_CHAT_MODEL=gemini-2.5-flash
DEFAULT_EXTRACTOR_MODEL=gemini-2.5-flash

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=true
