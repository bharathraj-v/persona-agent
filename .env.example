# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=persona_agent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy Async Database URL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/persona_agent

# LangGraph Checkpointer Postgres Connection String (psycopg format)
CHECKPOINTER_DB_URL=postgresql://postgres:postgres@localhost:5432/persona_agent

# LLM Providers (Configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Default Models
DEFAULT_CHAT_MODEL=gpt-4o-mini
DEFAULT_EXTRACTOR_MODEL=gpt-4o-mini

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=true
